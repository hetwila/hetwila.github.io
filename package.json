{
  "name": "hetwila-world",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare-content.ts",
    "dev": "pnpm prepare:content && pnpm run --parallel \"/^dev:/\"",
    "dev:content": "node --watch-path=content/wiki --watch-path=shared --watch-path=scripts --watch-path=sources scripts/prepare-content.ts",
    "dev:nuxt": "nuxt dev --host 0.0.0.0",
    "build": "pnpm prepare:content && nuxt build",
    "generate": "pnpm prepare:content && nuxt generate && pagefind --site .output/public",
    "preview": "serve .output/public --listen 4173 --no-clipboard",
    "typecheck": "pnpm prepare:content && nuxt typecheck",
    "test:content": "node --test tests/content.test.ts",
    "test:e2e": "playwright test",
    "test": "pnpm test:content && pnpm generate && pnpm test:e2e",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.147",
    "@nuxt/content": "3.16.2",
    "@nuxt/ui": "4.12.0",
    "better-sqlite3": "13.0.0",
    "nuxt": "4.6.2",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "mdast-util-to-string": "4.0.0",
    "pagefind": "1.5.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "serve": "14.2.5",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vue-tsc": "3.3.13"
  }
}
