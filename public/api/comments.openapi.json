    "/rest/v1/rpc/comment_can_post": {
      "post": {
        "operationId": "comment_can_post",
        "summary": "检查当前会话对指定评论区的有效投稿权限",
        "security": [
          {
            "apikey": [],
            "userSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "p_section_id": {
                    "type": "string",
