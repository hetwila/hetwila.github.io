            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Comment"
                  }
                }
              }
            }
          },
          "403": {
            "description": "禁止更新未授权列。"
          }
        }
      },
      "delete": {
        "operationId": "delete_comment",
        "summary": "作者删除本人评论；管理员删除任意评论",
        "security": [
          {
            "apikey": [],
            "userSession": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "description": "eq.<评论 UUID>"
          },
