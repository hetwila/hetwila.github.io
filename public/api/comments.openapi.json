          }
        ],
        "responses": {
          "200": {
            "description": "公开读取；关闭投稿不会隐藏历史评论。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Article"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "update_comment_articles",
        "summary": "管理员调整文章评论状态",
        "security": [
          {
            "apikey": [],
            "userSession": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "article_uid",
            "schema": {
              "type": "string"
            },
            "description": "eq.<目标唯一 ID>"
          },
          {
            "in": "header",
            "name": "Prefer",
            "schema": {
              "type": "string"
            },
            "example": "return=representation",
            "description": "要求返回实际修改的行，避免将 RLS 的空结果误判为成功。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "comments_enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "comments_enabled"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功；写操作必须检查返回行数。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Article"
                  }
                }
              }
            }
          },
          "403": {
            "description": "禁止更新未授权列。"
          }
        }
      }
    },
    "/rest/v1/article_comments": {
      "get": {
        "operationId": "list_article_comments",
        "summary": "读取 article_comments",
        "security": [
          {
            "apikey": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "section_id",
            "schema": {
              "type": "string"
            },
            "description": "eq.<评论区 UUID>"
          },
          {
            "in": "query",
            "name": "select",
            "schema": {
              "type": "string"
            },
            "description": "PostgREST 字段选择；评论可嵌入 author:comment_authors(nickname,avatar_path)。"
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "type": "string"
            },
            "description": "评论使用 created_at.asc,id.asc。"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "string"
            },
            "description": "每页20条。"
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "string"
            },
            "description": "从0开始的分页偏移。"
          },
          {
            "in": "header",
            "name": "Prefer",
            "schema": {
              "type": "string"
            },
            "example": "count=exact",
            "description": "用 count=exact 获取 Content-Range 总数。"
          }
        ],
        "responses": {
          "200": {
            "description": "公开读取；关闭投稿不会隐藏历史评论。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Comment"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_article_comments",
        "summary": "登录用户投稿；用户组及评论区／文章开关均由数据库校验",
        "security": [
          {
            "apikey": [],
            "userSession": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Prefer",
            "schema": {
              "type": "string"
            },
            "example": "return=representation",
            "description": "要求返回实际修改的行，避免将 RLS 的空结果误判为成功。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateComment"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "成功；写操作必须检查返回行数。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Comment"
                  }
                }
              }
            }
          },
          "403": {
            "description": "用户组、开关或管理员权限不允许。"
          }
        }
      },
      "patch": {
        "operationId": "update_article_comments",
        "summary": "仅作者本人修改正文；管理员不能改写他人评论",
        "security": [
          {
            "apikey": [],
            "userSession": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "description": "eq.<目标唯一 ID>"
          },
          {
            "in": "query",
            "name": "updated_at",
            "schema": {
              "type": "string"
            },
            "description": "eq.<上次读取的更新时间>，用于检测编辑冲突。"
          },
          {
            "in": "header",
            "name": "Prefer",
            "schema": {
              "type": "string"
            },
            "example": "return=representation",
            "description": "要求返回实际修改的行，避免将 RLS 的空结果误判为成功。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
