                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Comment"
                  }
                }
              }
            }
          },
          "204": {
            "description": "已处理；未要求返回实际行时不能据此推断删除了目标。"
          }
        }
      }
    },
