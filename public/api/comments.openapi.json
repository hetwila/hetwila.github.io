                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/comment_group_permissions": {
      "get": {
        "operationId": "list_comment_group_permissions",
        "summary": "已登录用户读取用户组评论能力；普通会话不可修改",
        "security": [
          {
            "apikey": [],
            "userSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功；写操作必须检查返回行数。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "user_group": {
                        "enum": [
                          "guest",
                          "admin"
                        ]
                      },
                      "can_post": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "user_group",
                      "can_post"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
