                "schema": {
                  "type": "object",
                  "properties": {
                    "avatarPath": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "输入、CAPTCHA 或邀请码验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionError"
                }
              }
            }
          },
          "401": {
            "description": "未登录或访问令牌失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionError"
                }
              }
            }
          },
          "403": {
            "description": "Origin 不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionError"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁"
          },
          "405": {
            "description": "仅支持 POST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionError"
                }
              }
            }
          },
          "413": {
            "description": "请求体过大",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionError"
                }
              }
            }
          },
          "503": {
            "description": "服务或配置不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary",
                "description": "最大524288字节；正方形，边长1–256像素。"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "公开 publishable key 或旧 anon key"
      },
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Auth 返回的用户 access_token"
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "user_group": {
            "type": "string",
            "enum": [
              "guest",
              "admin"
            ]
          },
          "avatar_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
